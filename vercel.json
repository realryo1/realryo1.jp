{
  "buildCommand": "npm install",
  "rewrites": [
    {
      "source": "/siguinkoicon/share",
      "destination": "/api/share"
    },
    {
      "source": "/siguinkoicon/api/og",
      "destination": "/api/og"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
